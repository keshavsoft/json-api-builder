{
  "root": "api",
  "port": 3000,
  "routes": {
    "v1": {
      "clinics": {
        "resource": "clinics",
        "idField": "id",
        "endpoints": [
          { "method": "GET", "path": "/", "operation": "list" },
          { "method": "POST", "path": "/", "operation": "create" },
          { "method": "GET", "path": "/:id", "operation": "read" },
          { "method": "PUT", "path": "/:id", "operation": "update" },
          { "method": "DELETE", "path": "/:id", "operation": "delete" }
        ]
      }
    }
  },
  "strategies": {
    "fs": {
      "file-sync": {
        "method": "GET",
        "path": "/file-sync",
        "dataFile": "data/clinics.json"
      }
    }
  }
}
