{
  "name": "json-api-builder",
  "version": "1.9.2",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "v9:folders": "node ./test/v9/create-folders.js",
    "v9:files": "node ./test/v9/create-files.js",
    "v9:content": "node ./test/v9/insert-content.js",
    "v9:routes": "node ./test/v9/hook-routes.js",
    "v9:app": "node ./test/v9/app/create-app.js",
    "v9:endpoints": "node ./test/v9/endpoints/file-sync.js && node ./test/v9/endpoints/create-endpoints.js",
    "v9:app-hooks": "node ./test/v9/app/hook-app-strategies.js",
    "v9:build": "node ./test/v9/build.js",
    "v9:test": "node --test --test-concurrency=1 ./test/v9/v9.test.js ./test/v9/validation/runtime.test.js",
    "v9:runtime-test": "node --test ./test/v9/validation/runtime.test.js",
    "v9:start": "node ./test/v9/output/app.js",
    "v9:validate": "node --test --test-concurrency=1 ./test/v9/v9.test.js ./test/v9/validation/runtime.test.js"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "json-traversal-core": "1.2.1",
    "hono": "^4.10.6",
    "@hono/node-server": "^1.19.6"
  },
  "main": "./src/v9/index.js",
  "exports": {
    ".": "./src/v9/index.js",
    "./v9": "./src/v9/index.js",
    "./v9/*": "./src/v9/*"
  }
}
